{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "shadcn-ui": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn-ui-mcp-server"
      ]
    },
    "tailgrids": {
      "command": "npx",
      "args": [
        "-y",
        "@tailgrids/mcp"
      ]
    },
    "livekit-docs": {
      "serverUrl": "https://docs.livekit.io/mcp"
    },
    "langgraph-docs": {
      "serverUrl": "https://docs.langchain.com/mcp"
    }
  }
}
