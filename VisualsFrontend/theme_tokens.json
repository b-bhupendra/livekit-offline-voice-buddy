{
  "themeName": "DarkNotebookSketch",
  "version": "1.0.0",
  "colors": {
    "background": {
      "primary": "#0b0f19",
      "secondary": "#131b2e",
      "card": "rgba(30, 41, 59, 0.75)",
      "cardHover": "rgba(51, 65, 85, 0.85)"
    },
    "highlighters": {
      "neonYellow": {
        "bg": "#fef08a",
        "text": "#713f12",
        "purpose": "Golden Grammar Rules"
      },
      "cyan": {
        "bg": "#cffafe",
        "text": "#164e63",
        "purpose": "Sentence Pattern Formulas"
      },
      "lilac": {
        "bg": "#f3e8ff",
        "text": "#581c87",
        "purpose": "Native Colloquialisms & Idioms"
      }
    },
    "badges": {
      "correct": {
        "bg": "rgba(34, 197, 94, 0.15)",
        "border": "#22c55e",
        "text": "#4ade80"
      },
      "error": {
        "bg": "rgba(239, 68, 68, 0.15)",
        "border": "#ef4444",
        "text": "#f87171"
      },
      "dispute": {
        "bg": "rgba(245, 158, 11, 0.15)",
        "border": "#f59e0b",
        "text": "#fbbf24"
      }
    }
  },
  "sketchStyle": {
    "cardBorderRadius": "255px 15px 225px 15px / 15px 225px 15px 255px",
    "borderWidth": "2px",
    "boxShadow": "4px 6px 0px rgba(0, 0, 0, 0.35)",
    "stickyNoteAngle": "-1.5deg"
  },
  "fonts": {
    "headings": "'Outfit', sans-serif",
    "body": "'Inter', sans-serif",
    "handwriting": "'Caveat', cursive",
    "code": "'JetBrains Mono', monospace"
  },
  "bionicReading": {
    "defaultEnabled": true,
    "fixationRatio": 0.45,
    "minWordLength": 2
  },
  "generativeUiComponents": [
    "QuizCard",
    "ContentionResolver",
    "InteractiveWorksheet",
    "BionicSketchNote",
    "RecastChip",
    "SyllabusProgressTree"
  ]
}
