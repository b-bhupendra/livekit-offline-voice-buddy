# LiveKit Server Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen-buddy

# Local Audio Server (TTS / STT Fallback)
AUDIO_SERVER_PORT=8880
AUDIO_SERVER_URL=http://127.0.0.1:8880/v1

# Voice pacing and clarity (>1.0 = slower & clearer articulation)
PIPER_LENGTH_SCALE=1.18
PIPER_NOISE_SCALE=0.5


# Kokoro TTS (Tier 1 — warm, expressive)
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# Piper TTS params (Tier 2 fallback)
PIPER_LENGTH_SCALE=1.05
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8

# PDF reference books (stored outside repo)
BOOKS_DIR=~/buddy_reference_books
